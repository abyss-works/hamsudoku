generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())
}

model Profile {
  userId    String   @id
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClearRecord {
  userId          String
  stageCode       String
  bestElapsedSec  Int?
  attempts        Int      @default(0)
  lastClearedAt   DateTime
  updatedAt       DateTime @updatedAt

  @@id([userId, stageCode])
  @@index([userId])
}

model ClearEvent {
  id         String   @id @default(uuid())
  userId     String
  stageCode  String
  elapsedSec Int
  verified   Boolean  @default(true)
  clearedAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, stageCode])
}

model Attempt {
  id        String    @id @default(uuid())
  userId    String
  stageCode String
  issuedAt  DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model EndlessStage {
  id         String   @id
  size       Int
  regions    String
  solution   String
  tier       Int
  seed       Int
  plays      Int      @default(0)
  clears     Int      @default(0)
  avgClearMs Int      @default(0)
  createdAt  DateTime @default(now())
}

model EndlessProgress {
  userId       String
  stageId      String
  cleared      Boolean  @default(false)
  attempts     Int      @default(0)
  lastPlayedAt DateTime

  @@id([userId, stageId])
  @@index([userId, cleared])
}

model SeedWallet {
  userId  String @id
  balance Int    @default(0)
}

model SeedLedger {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  amount    Int
  stageId   String?
  season    String
  createdAt DateTime @default(now())

  @@index([season, kind])
  @@index([userId, season])
}

model EndlessEvent {
  id         String   @id @default(uuid())
  userId     String
  stageId    String
  seedLeft   Int
  elapsedMs  Int
  verified   Boolean
  suspicious Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId, stageId])
}
