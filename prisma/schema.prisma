generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())
}

model Profile {
  userId    String   @id
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClearRecord {
  userId          String
  stageCode       String
  bestElapsedSec  Int?
  attempts        Int      @default(0)
  lastClearedAt   DateTime
  updatedAt       DateTime @updatedAt

  @@id([userId, stageCode])
  @@index([userId])
}

model ClearEvent {
  id         String   @id @default(uuid())
  userId     String
  stageCode  String
  elapsedSec Int
  verified   Boolean  @default(true)
  clearedAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, stageCode])
}

model Attempt {
  id        String    @id @default(uuid())
  userId    String
  stageCode String
  issuedAt  DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model EndlessStage {
  id           String   @id
  size         Int
  regions      String
  solution     String
  tier         Int
  seed         Int
  plays        Int      @default(0)
  clears       Int      @default(0)
  avgClearMs   Int      @default(0)
  clearTotalMs BigInt   @default(0)
  createdAt    DateTime @default(now())

  @@index([clears])
}

model EndlessSupplyJob {
  id             String               @id
  policyVersion  String
  seedStart      Int
  seedEnd        Int
  targetCount    Int                  @default(10)
  status         String               @default("pending")
  leaseExpiresAt DateTime?
  lastSuccessAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  chunks         EndlessSupplyChunk[]

  @@index([status, leaseExpiresAt])
}

model EndlessSupplyChunk {
  id          String           @id
  jobId       String
  chunkIndex  Int
  status      String           @default("pending")
  stageCount  Int              @default(0)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  job         EndlessSupplyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, chunkIndex])
  @@index([jobId])
}

model EndlessProgress {
  userId       String
  stageId      String
  cleared      Boolean  @default(false)
  attempts     Int      @default(0)
  lastPlayedAt DateTime

  @@id([userId, stageId])
  @@index([userId, cleared])
}

model SeedWallet {
  userId  String @id
  balance Int    @default(0)
}

model SeedLedger {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  amount    Int
  stageId   String?
  season    String
  createdAt DateTime @default(now())

  @@index([season, kind])
  @@index([userId, season])
}

model EndlessEvent {
  id         String   @id @default(uuid())
  userId     String
  stageId    String
  seedLeft   Int
  elapsedMs  Int
  verified   Boolean
  suspicious Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId, stageId])
}

model EndlessStreak {
  userId  String @id
  current Int    @default(0)
  best    Int    @default(0)
}
