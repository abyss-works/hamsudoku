# 복사해서 .env.local로 쓴다: cp .env.example .env.local
# BETTER_AUTH_SECRET 또는 BETTER_AUTH_URL이 없으면 로컬 모드(동기화 생략)로 돈다.

# Better Auth 세션 서명 비밀값 (32자 이상 무작위 문자열)
BETTER_AUTH_SECRET=
# 앱의 공개 주소. 재설정 메일 링크의 기준이다. 예: https://hamsudoku.abyssworks.dev
BETTER_AUTH_URL=
# Resend API 키와 발신 주소. 재설정 메일 발송에 쓴다. 예: hamsudoku <no-reply@abyssworks.dev>
RESEND_API_KEY=
MAIL_FROM=
# Postgres 연결 (Supabase pooler. 기본 6543, 막히는 네트워크면 5432)
DATABASE_URL=
# 직접 연결 (5432, 마이그레이션 CLI 전용. 풀러 경유 시 DDL이 실패한다)
DIRECT_URL=

# Upstash Redis REST (랭킹 ZSET. 비우면 랭킹이 비활성화된다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (주간 랭킹 자동 확정 및 스케줄러)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
INTERNAL_SECRET=
APP_URL=
# 보호된 Preview의 QStash 전달에 사용하는 선택적 서버 자격
QSTASH_PROTECTION_BYPASS=

# Sentry DSN (비우면 Sentry가 꺼진다. 브라우저에 노출되는 공개 값)
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (빌드 시점에만 쓴다. 로컬은 비워 둔다)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

