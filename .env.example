# 복사해서 .env.local로 쓴다: cp .env.example .env.local
# 없으면 로컬 모드(동기화 생략)로 돈다.

# Supabase 프로젝트 URL
SUPABASE_URL=
# anon public key (서버 세션용. 브라우저에는 노출하지 않는다)
SUPABASE_ANON_KEY=
# service_role key (예약, 현 코드 미사용)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres 연결 (6543 풀링, Prisma용)
DATABASE_URL=

# Sentry DSN (비우면 Sentry가 꺼진다. 브라우저에 노출되는 공개 값)
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (빌드 시점에만 쓴다. 로컬은 비워 둔다)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
